# Production Docker Compose configuration. Do not commit the real .env file.
# SERVER_PUBLIC_ADDR must be the Ubuntu server's public IPv4 plus UDP port.
GAME_DOMAIN=game.example.com
SERVER_PUBLIC_ADDR=203.0.113.10:42069
SERVER_MAX_CLIENTS=128

# Generate with: openssl rand -hex 32
NETCODE_PRIVATE_KEY=replace-with-64-hexadecimal-characters

# Use long, unique passwords. URL-encode special characters in DATABASE_URL.
MYSQL_PASSWORD=replace-with-a-long-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-root-password
DATABASE_URL=mysql://roguelike:replace-with-a-long-database-password@mysql:3306/roguelike

RUST_LOG=info,rechannel=warn
