FROM rust:1-bookworm AS builder

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY migrations ./migrations

RUN cargo build --locked --release --no-default-features \
    --features server,batched_position_snapshots --bin server

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 tribute

WORKDIR /app
COPY --from=builder /build/target/release/server /app/tribute-server
COPY assets/terrain /app/assets/terrain

USER tribute
EXPOSE 42069/udp 8080/tcp
ENTRYPOINT ["/app/tribute-server"]
