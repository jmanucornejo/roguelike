# The server runs without persistence when DATABASE_URL is unset.
# The Docker Compose MySQL service uses these development credentials.
# Embedded SQLx migrations create the tables when the game server connects.
DATABASE_URL=mysql://roguelike:change-me@127.0.0.1:3306/roguelike
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=root-change-me
PHPMYADMIN_PORT=8080

# Temporary identity until login and character selection are implemented.
# Keep this value stable to load the same character after reconnecting.
PLAYER_ACCOUNT_ID=1
