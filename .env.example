# Local development database. Embedded SQLx migrations run when the server connects.
DATABASE_URL=mysql://roguelike:change-me@127.0.0.1:3306/roguelike
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=root-change-me
PHPMYADMIN_PORT=8080

# Local networking defaults are shown for clarity and may be omitted.
SERVER_BIND_ADDR=127.0.0.1:42069
SERVER_PUBLIC_ADDR=127.0.0.1:42069
SERVER_ADDR=127.0.0.1:42069
SERVER_MAX_CLIENTS=128
# ASSET_ROOT=G:/dev/tribute/assets

# Local development defaults to loopback-only unsecure networking. To exercise
# the secure flow locally, generate a key with `openssl rand -hex 32`, uncomment
# both lines, and start the client with SERVER_TOKEN_URL=http://127.0.0.1:8080/token.
# NETCODE_PRIVATE_KEY=replace-with-64-hexadecimal-characters
# TOKEN_BIND_ADDR=127.0.0.1:8080
